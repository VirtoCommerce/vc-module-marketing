{
  // Marketing admin UI for the Admin Shell host (Module Federation remote).
  // Promotions replace the legacy "Marketing" item in place; dynamic content gets its own item next to it.
  "remote": { "name": "marketing_admin", "exposed": "./Module" },
  "contributions": {
    "menu": [
      {
        "id": "marketing",
        "sectionId": "marketing",
        "title": "Promotions",
        "icon": "lucide-flag",
        "route": "/marketing",
        "permission": "marketing:access",
        "priority": 10,
        "replaces": "legacy.marketing"
      },
      {
        "id": "marketing.dynamicContent",
        "sectionId": "marketing",
        "title": "Dynamic content",
        "icon": "lucide-layout-template",
        "route": "/dynamic-content",
        "permission": "marketing:access",
        "priority": 11
      }
    ]
  }
}
