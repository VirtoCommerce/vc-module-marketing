<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <noWarn>1591</noWarn>
    <OutputType>Library</OutputType>
    <IsPackable>False</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Compile Remove="node_modules\**" />
    <EmbeddedResource Remove="dist\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="dist\**" />
    <None Remove="node_modules\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.AssetsModule.Core" Version="3.1010.0" />
    <PackageReference Include="VirtoCommerce.Platform.Modules" Version="3.1076.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.MarketingModule.Core\VirtoCommerce.MarketingModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketingModule.Data.MySql\VirtoCommerce.MarketingModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketingModule.Data.PostgreSql\VirtoCommerce.MarketingModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketingModule.Data.SqlServer\VirtoCommerce.MarketingModule.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketingModule.Data\VirtoCommerce.MarketingModule.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>